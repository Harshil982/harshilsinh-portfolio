# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Required for the AI chatbot mascot ("Orbit") to give real answers.
# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the Gemini model used by the chatbot.
# Defaults to gemini-3.5-flash if unset.
# GEMINI_MODEL=gemini-3.5-flash
